name: Windows EXE oluştur

on:
  workflow_dispatch:
  push:
    branches:
      - main
    paths:
      - "**.py"
      - "requirements.txt"
      - ".github/workflows/build-windows.yml"

permissions:
  contents: read

jobs:
  build-windows:
    name: Windows x64 EXE
    runs-on: windows-latest

    steps:
      - name: Kaynak kodu indir
        uses: actions/checkout@v4

      - name: Python kur
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip

      - name: Bağımlılıkları kur
        shell: pwsh
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          pip install pyinstaller

      - name: EXE oluştur
        shell: pwsh
        run: |
          pyinstaller `
            --noconfirm `
            --clean `
            --onefile `
            --name MC-Launcher-Py `
            --collect-all minecraft_launcher_lib `
            launcher.py

      - name: EXE dosyasını artifact olarak yükle
        uses: actions/upload-artifact@v4
        with:
          name: MC-Launcher-Py-windows-x64
          path: dist/MC-Launcher-Py.exe
          if-no-files-found: error
          retention-days: 30
